# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE AUTHENTICATION CONFIGURATION
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ACADEMY ADMINISTRATION
# Comma-separated, verified Firebase emails allowed to bootstrap admin access.
# Prefer academyRole=admin custom claims for additional administrators.
ACADEMY_ADMIN_EMAILS="admin@gom-mar.de"

# SENDGRID TRANSACTIONAL EMAIL
# Store the API key only as a protected Cloud Run environment variable or secret.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
SENDGRID_FROM_NAME="GOM-MAR Academy"

# SCHEDULER AUTHORIZATION SECRET
# Used to secure the internal POST /api/internal/scheduler/run endpoint for Cloud Scheduler / Firebase Cron
SCHEDULER_SECRET=""

# INSTAGRAM API WITH INSTAGRAM LOGIN
# Store the app secret and encryption key only in Secret Manager / protected Cloud Run secrets.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_TOKEN_ENCRYPTION_KEY=""
INSTAGRAM_OAUTH_REDIRECT_URI="https://academy.gomo-marketing.at/api/instagram/oauth/callback"
INSTAGRAM_GRAPH_API_VERSION="v24.0"
# Optional. Wenn leer, wird der bereits konfigurierte LESSON_AUDIO_BUCKET verwendet.
INSTAGRAM_MEDIA_BUCKET=""
