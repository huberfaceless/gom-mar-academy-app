rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function canSchedulePublishing() {
      return isAuthenticated()
        && request.auth.token.get('email_verified', false) == true
        && (request.auth.token.get('academyTier', 'FREE') in ['PRO', 'PREMIUM']
          || request.auth.token.get('academyRole', 'member') == 'admin'
          || request.auth.token.get('admin', false) == true
          || request.auth.token.get('email', '') == 'admin@gom-mar.de');
    }

    function isAcademyAdmin() {
      return isAuthenticated()
        && request.auth.token.get('email_verified', false) == true
        && (request.auth.token.get('academyRole', 'member') == 'admin'
          || request.auth.token.get('admin', false) == true
          || request.auth.token.get('email', '') == 'admin@gom-mar.de');
    }

    function isVital50Id(value) {
      return value is string && value.lower().matches('proj_vital50(_.*)?');
    }

    function isVital50Url(value) {
      return value is string && value.lower().matches('https?://vital50[.]gomo-marketing[.]at([/:?#].*)?');
    }

    function isVital50Project(data) {
      return isVital50Id(data.get('id', ''))
        || (data.get('name', '') is string && data.get('name', '').trim().lower().matches('vital[ ]*50([ ].*)?'))
        || isVital50Url(data.get('websiteUrl', ''))
        || isVital50Url(data.get('defaultTargetUrl', ''))
        || isVital50Url(data.get('targetUrl', ''));
    }

    function canUseContentProject(data) {
      return isAcademyAdmin() || (!isVital50Project(data)
        && !isVital50Project(data.get('projectSettings', {}))
        && !isVital50Id(data.get('projectId', ''))
        && !isVital50Url(data.get('payload', {}).get('targetUrl', '')));
    }

    // User Profile: Users can only read and modify their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Brand / Project Settings
    match /projects/{projectId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
        && canUseContentProject(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && canUseContentProject(resource.data) && canUseContentProject(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Central Content Projects (Briefs, Articles, Pins, Videos, Shorts)
    match /contentProjects/{contentProjectId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
        && canUseContentProject(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && canUseContentProject(resource.data) && canUseContentProject(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Client edits are limited to waiting, unpublished jobs. Worker state is server-owned.
    function isWaitingPublishingJob(data) {
      return data.get('status', '') in ['DRAFT', 'SCHEDULED', 'NEEDS_REVIEW']
        && data.get('publicationUncertain', false) == false
        && data.get('externalId', '') in ['', null]
        && data.get('publishedAt', '') in ['', null]
        && data.get('lockedAt', '') in ['', null]
        && data.get('lockedBy', '') in ['', null]
        && data.get('lockExpiresAt', '') in ['', null];
    }

    match /publishingJobs/{jobId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if canSchedulePublishing()
        && canUseContentProject(request.resource.data)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == jobId
        && request.resource.data.keys().hasOnly([
          'id', 'userId', 'projectId', 'contentProjectId', 'contentId', 'platform',
          'contentType', 'scheduledAt', 'status', 'payload', 'createdAt', 'updatedAt',
          'attempts', 'maxAttempts', 'executionLogs'
        ])
        && isWaitingPublishingJob(request.resource.data)
        && request.resource.data.attempts == 0
        && request.resource.data.maxAttempts == 3
        && request.resource.data.executionLogs == [];
      allow update: if canSchedulePublishing()
        && canUseContentProject(resource.data) && canUseContentProject(request.resource.data)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && isWaitingPublishingJob(resource.data)
        && isWaitingPublishingJob(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'payload', 'scheduledAt', 'status', 'updatedAt'
        ]);
      // Cancellation uses deletion; never remove an in-flight or uncertain job.
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid
        && resource.data.get('status', '') != 'PUBLISHING'
        && resource.data.get('publicationUncertain', false) == false
        && resource.data.get('lockedAt', '') in ['', null]
        && resource.data.get('lockedBy', '') in ['', null]
        && resource.data.get('lockExpiresAt', '') in ['', null];
    }

    // Scheduler Jobs
    match /schedulerJobs/{jobId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if canSchedulePublishing() && canUseContentProject(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if canSchedulePublishing() && canUseContentProject(resource.data) && canUseContentProject(request.resource.data) && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
